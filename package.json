{
  "name": "daoyan",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "道衍 —— 修仙编程 roguelike：玩家自由编写功法，用有限的神识 / 法力 / 耗时换取能力",
  "author": "Daoyan",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "desktop": "node scripts/desktop.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --x64",
    "sandbox": "tsx src/demo/playground.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:generate": "tsx scripts/generate-meta-reference.ts",
    "docs:check": "tsx scripts/generate-meta-reference.ts --check && node scripts/check-docs.mjs",
    "producer": "tsx scripts/agent-dispatcher.ts",
    "producer:doctor": "tsx scripts/agent-dispatcher.ts --doctor",
    "producer:plan": "tsx scripts/agent-dispatcher.ts --plan-only",
    "producer:resume": "tsx scripts/agent-dispatcher.ts --resume",
    "producer:batch": "tsx scripts/version-dispatcher.ts",
    "producer:batch:plan": "tsx scripts/version-dispatcher.ts --plan-only",
    "producer:batch:resume": "tsx scripts/version-dispatcher.ts --resume",
    "secretary": "tsx scripts/project-secretary.ts",
    "secretary:start": "tsx scripts/project-secretary.ts start",
    "secretary:open": "tsx scripts/project-secretary.ts open",
    "secretary:status": "tsx scripts/project-secretary.ts status",
    "secretary:stop": "tsx scripts/project-secretary.ts stop",
    "secretary:site:build": "tsx scripts/build-secretary-site.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm run test",
    "verify:full": "npm run verify && npm run coverage && npm run sandbox && npm run test:e2e && npm run build",
    "verify:ci": "npm run verify:full",
    "hooks": "node scripts/install-hooks.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.daoyan.app",
    "productName": "道衍",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "道衍-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "道衍-${version}-免安装.${ext}"
    }
  }
}
