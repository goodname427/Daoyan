// 道衍默认用户法术书。所有入口均按当前权限与资源合同编写。
// 五参创建弹道会预付初始运动和一次伤害储能；绑定与实战共用此书。

spell 基础剑气 {
  创建弹道(自身位置(), 准星方向(), 380, 18, 2.4)
}

spell 微剑 {
  创建弹道(自身位置(), 准星方向(), 420, 16, 2.4)
}

spell 三连剑 {
  var origin: vec2 = 自身位置()
  var direction: vec2 = 准星方向()
  创建弹道(origin, direction, 380, 14, 2.4)
  创建弹道(origin, 旋转(direction, 0.16), 380, 14, 2.4)
  创建弹道(origin, 旋转(direction, -0.16), 380, 14, 2.4)
}

spell 爆炎咒 {
  近战斩击(准星方向(), 150, 30)
}

spell 御剑·手动 {
  创建弹道(自身位置(), 准星方向(), 380, 22, 2.4)
}

// 三种法球的可绑定例子：观察滑行、运动池耗尽、扫描池耗尽后的轨迹。
spell 法球·冲量滑行 {
  var ball: entity = 创建弹道(自身位置(), 准星方向(), 120, 10, 2.4)
  设置法球滑行(ball)
}

spell 法球·持续推进 {
  var ball: entity = 创建弹道(自身位置(), 准星方向(), 120, 10, 2.4)
  注入运动能量(ball, 5)
  设置法球推进(ball, 数乘(准星方向(), 30))
}

spell 法球·目标追踪 {
  var seen: query<entities> = 扫描敌人(自身位置(), 240)
  if 查询可用(seen) {
    var foes: list<entity, 1> = 查询实体列表(seen)
    for foe in foes {
      var ball: entity = 创建弹道(自身位置(), 准星方向(), 120, 10, 2.4)
      注入运动能量(ball, 5)
      注入扫描能量(ball, 3)
      设置法球追踪(ball, foe, 30)
    }
  }
}

spell 疾风步 {
  传送(自身实体(), 向量加(自身位置(), 数乘(准星方向(), 170)))
}

spell 护体金光 @kind=duration @period=1.5 @duration=6 {
  调整护体(自身实体(), 6, 2.5)
}

spell 蓄力火球 @kind=duration @period=0.05 @duration=10 @keys=蓄力 {
  if 按键松开(0) {
    var t: num = 按键蓄力(0)
    if 大于等于(t, 0.8) {
      创建弹道(自身位置(), 准星方向(), 380, 加(20, 乘(最小(t, 2), 40)), 2.4)
    }
    结束施法()
  }
}

spell 天雷引 @kind=channel @duration=2 {
  创建弹道(自身位置(), 准星方向(), 380, 45, 2.4)
}

// 妖兽与玩家使用同一个 Actor 和施法管线。
spell 妖兽·扑击 {
  近战斩击(准星方向(), 90, 14)
}

spell 妖兽·雷符 {
  创建弹道(自身位置(), 准星方向(), 380, 13, 2.4)
}
