{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "disposition", "response", "direction", "scope", "taskTitles"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["question", "direction", "reply", "continue"]
    },
    "disposition": {
      "type": "string",
      "enum": ["completed", "active", "scheduled", "new", "waiting-producer"]
    },
    "response": { "type": "string" },
    "direction": { "type": "string" },
    "scope": { "type": "string", "enum": ["feature", "version"] },
    "taskTitles": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 6
    }
  }
}
