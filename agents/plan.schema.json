{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "summary",
    "producerDecisionRequired",
    "producerQuestion",
    "riskSignals",
    "acceptanceCriteria",
    "nonGoals",
    "tasks",
    "commitMessage"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "producerDecisionRequired": { "type": "boolean" },
    "producerQuestion": { "type": "string" },
    "riskSignals": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "objective",
          "type",
          "tier",
          "reasoning",
          "dependsOn",
          "paths",
          "deliverables",
          "verification"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["analysis", "implementation", "test", "documentation"]
          },
          "tier": {
            "type": "string",
            "enum": ["economy", "standard", "advanced", "critical"]
          },
          "reasoning": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } },
          "deliverables": { "type": "array", "items": { "type": "string" } },
          "verification": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "commitMessage": {
      "type": "string",
      "pattern": "^(feat|fix|docs|refactor|test|chore|perf|build|ci)(\\([^)]+\\))?!?: .+"
    }
  }
}
